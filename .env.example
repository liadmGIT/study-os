# סיסמה לכניסה למערכת (חובה בשרת)
APP_PASSWORD=change-me
# מפתח הצפנה לטוקן של Moodle – מחרוזת אקראית ארוכה (openssl rand -base64 32)
ENCRYPTION_KEY=
# מפתח לחתימת עוגיות session – מחרוזת אקראית ארוכה
SESSION_SECRET=
# כתובת ה-Moodle (ברירת מחדל: בן גוריון)
MOODLE_URL=https://moodle.bgu.ac.il/moodle
# תיקיית נתונים קבועה (בשרת: הדיסק הקבוע)
DATA_DIR=/data
# כתובת ציבורית של המערכת (לקישורים בהתראות וביומן)
PUBLIC_URL=
# כמה proxy-ים לפני השרת (Railway / Caddy = 1). 0 אם השרת חשוף ישירות
TRUST_PROXY_HOPS=1
# כתובת יצירת קשר עבור Web Push (לא חובה)
VAPID_SUBJECT=mailto:you@example.com

# רק לשרת עצמאי עם docker compose: הדומיין לתעודת HTTPS
DOMAIN=
